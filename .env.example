# Configuración web de Firebase (proyecto yaleh-fbe1c). Obtenida con:
#   firebase apps:sdkconfig WEB --project yaleh-fbe1c
# Copia este archivo como .env y completa los valores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Clave del sitio de Google Cloud Fraud Defense (App Check)
VITE_APPCHECK_SITE_KEY=
# Token de depuración de App Check (opcional; registrarlo en la consola)
VITE_APPCHECK_DEBUG_TOKEN=
# true para usar el token de depuración también en la web publicada (solo demostraciones)
VITE_APPCHECK_DEBUG_ON_WEB=false
