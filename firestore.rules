rules_version = '2';

// YALEH — brief, sección 8.3.
// Cada usuario solo puede leer y escribir bajo users/{su uid}
// (perfil, sesiones, fuentes y sus partes de texto, notas y resultados de la IA).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
