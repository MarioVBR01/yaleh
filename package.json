{
  "name": "yaleh",
  "private": true,
  "version": "1.0.1",
  "description": "YALEH: entorno de estudio con bloqueo del sistema operativo e IA para estudiantes del TECBA",
  "author": "Mario Víctor Brañez Rodriguez",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:electron",
    "build:electron": "node scripts/build-electron.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs run",
    "test:watch": "node scripts/test.mjs",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev-server\"",
    "electron:preview": "npm run build && electron .",
    "smoke:electron": "npm run build && node scripts/smoke-electron.mjs",
    "db:inspect": "node scripts/db-inspect.mjs",
    "bench:local-ai": "npm run build:electron && node scripts/bench-local-ai.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "deploy:web": "npm run build && firebase deploy --only hosting --project yaleh-fbe1c",
    "release:github": "node scripts/release-github.mjs"
  },
  "dependencies": {
    "node-llama-cpp": "^3.22.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "clsx": "2.1.1",
    "concurrently": "^10.0.3",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "firebase": "^12.15.0",
    "framer-motion": "^12.40.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^1.18.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "^5.0.2",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
